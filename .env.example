# Supabase Configuration
# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (server-side only, NEVER expose to browser)
# Only needed for admin operations like overlay credential management
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application URL (used for generating overlay URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Default currency for new auctions
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
